yarn-error.log
.pnpm-debug.log

# Runtime image cache — regenerated on demand by api/v1/img.php, never commit these
api/cache/
backend/cache/

# Generated data payloads and runtime state.
# These live on disk (they are what the web server publishes) but they are output,
# not source. Rewritten by the cron every 3 minutes.
# NOTE: api/data/.htaccess is deliberately NOT ignored — it carries the CORS headers
# under Apache in development. Production is nginx, where those headers come from the
# vhost instead. See docs/operations.md#static-json-headers
# and must be deployed with the rest of the tree.
api/data/*.json
backend/config/cron-state.json
backend/config/alerts.json

# Credentials and the live site registry — never commit these.
# Committed templates sit next to them as *.example.* — those ARE tracked.
backend/config/secrets.php
backend/config/site-mapping.json